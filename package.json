{
  "name": "cynx",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run server",
    "ci": "npm run typecheck && npm run test:unit && npm run build",
    "test:unit": "vitest run server",
    "test:api": "vitest run server/index.test.ts && playwright test tests/api",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test tests/smoke",
    "test:regression": "playwright test tests/e2e tests/api",
    "qa": "pnpm run typecheck && pnpm run test:unit && pnpm run test:smoke"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "express": "^4.18.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.25",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.3",
    "cross-env": "^7.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@9.15.9"
}
